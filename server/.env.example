# Server configuration (NEVER expose these to /app or web bundles)
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*

# Provider selection: auto | anthropic | openai | gemini | mock
# - auto: uses Anthropic if ANTHROPIC_API_KEY is set, else OpenAI, else Gemini, else mock
LLM_PROVIDER=auto

# Optional LLM API keys (server-only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cache & RAG settings
CACHE_TTL_SECONDS=300
RAG_MIN_SCORE=0.65
